{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/chat",
        "run": {
          "serviceId": "chat",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options",      "value": "nosniff" },
          { "key": "X-Frame-Options",              "value": "DENY" },
          { "key": "X-XSS-Protection",             "value": "1; mode=block" },
          { "key": "Referrer-Policy",              "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy",           "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Strict-Transport-Security",    "value": "max-age=63072000; includeSubDomains; preload" },
          { "key": "Content-Security-Policy",      "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.googleapis.com https://*.firebase.com https://*.firebaseio.com https://api.anthropic.com https://*.stripe.com https://createsubscription-5hpofkxo2a-uc.a.run.app https://chat-5hpofkxo2a-uc.a.run.app; frame-src https://js.stripe.com https://hooks.stripe.com;" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/registerSW.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
